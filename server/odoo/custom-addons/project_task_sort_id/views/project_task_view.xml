<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit the task list view and override default_order -->
    <record id="project_task_view_tree_main_inherit" model="ir.ui.view">
        <field name="name">project.task.view.tree.main.inherit.sortid</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.project_task_view_tree_main_base"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">id asc</attribute>
            </xpath>
        </field>
    </record>

</odoo>
